# ========================================================
# KNOWLEDGE BRIDGE AI — Environment Configuration (.env)
# STRICT ZERO-BUDGET POLICY: 100% Free Tiers Only (₹0.00)
# ========================================================

# --- 1. Cloud Database (Neon PostgreSQL Free Tier) ---
# Obtain your free permanent PostgreSQL connection string from https://neon.tech (No credit card required).
# Leave empty for local development (defaults to zero-cost embedded SQLite).
DATABASE_URL=postgresql://alex:AbCdEf123456@ep-cool-dawn-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- 2. Free AI Engine (Google Gemini 3.8 Flash via AI Studio) ---
# Obtain your free API key from https://aistudio.google.com/app/apikey (No credit card / billing required).
# Model: gemini-3.8-flash (Free Tier). Dynamic quota handling: If quota is exceeded (HTTP 429),
# the platform automatically operates in Zero-Cost Heuristic Fallback Mode without paid charges.
GEMINI_API_KEY=AIzaSyYourFreeGeminiApiKeyHere

# --- 3. Mandatory Security & Authentication Secrets ---
# High-entropy random tokens required for RBAC. Never use predictable values.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=your-random-high-entropy-admin-token-here
TEAM_TOKEN=your-random-high-entropy-team-token-here
SECRET_KEY=your-random-high-entropy-secret-key-here

# --- 4. AI Provider Selection ---
# Options: "auto" (default), "gemini", "fallback"
AI_PROVIDER=auto

# --- 5. Server Port (Local run only) ---
PORT=8000

